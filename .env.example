# AgentCrawl Environment Variables

# Browser Configuration
AGENTCRAWL_HEADLESS=true
AGENTCRAWL_STEALTH=true
AGENTCRAWL_BROWSER=chromium
AGENTCRAWL_TIMEOUT=30

# Cache Configuration
AGENTCRAWL_CACHE_BACKEND=memory
AGENTCRAWL_REDIS_URL=redis://localhost:6379

# Server Configuration (Server Mode)
AGENTCRAWL_AUTH_ENABLED=false
AGENTCRAWL_API_KEY=your-secret-key-here
AGENTCRAWL_RATE_LIMIT=100/minute

# Queue Configuration
AGENTCRAWL_QUEUE_BACKEND=memory

# LLM Configuration (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
